---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';

interface Props { title: string; description: string; path: string; updated: string; lead: string }
const { title, description, path, updated, lead } = Astro.props;
---

<BaseLayout {title} {description} {path}>
  <PageHero id="legal-titulo" tone="crema" eyebrow="Información legal" {title} {lead} />
  <section class="section">
    <div class="container">
      <div class="prose">
        <slot />
        <p class="updated">Última actualización: {updated}.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose { max-width: 72ch; }
  .prose :global(h2) { font-size: var(--imp-fs-h3); margin-top: 40px; margin-bottom: 12px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(ul) { list-style: disc; padding-left: 1.25em; margin-block: 1em; display: grid; gap: 6px; }
  .updated { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--imp-gris-claro); font-size: 0.875rem; color: var(--imp-gris); }
</style>

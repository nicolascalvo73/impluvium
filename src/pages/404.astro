---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Página no encontrada" path="/404">
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esta página</h1>
      <p class="lead">Puede que el enlace haya cambiado. Volvé al inicio para seguir navegando.</p>
      <Button href={url('/')}>Ir al inicio</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { display: grid; gap: 20px; justify-items: start; min-height: 40vh; align-content: center; }
</style>

---
import { advisors, executive, friends } from '../../data/team';
import Placeholder from '../ui/Placeholder.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="equipo" class="section bg-neutro" aria-labelledby="equipo-t">
  <div class="container">
    <SectionHeading id="equipo-t" eyebrow="Equipo" title="¿Quiénes integran IMPLUVIUM?" />

    <h3>Comisión ejecutiva</h3>
    <ul class="people" data-stagger>
      {executive.map((m) => (
        <li>
          <div class="photo" role="img" aria-label={`Foto de ${m.name}: a definir`}><span>Fotos a definir</span></div>
          <p class="name">{m.name}</p>
          <p class="role">{m.role ?? <Placeholder text="Cargo a definir" />}</p>
          <p class="area">{m.area}</p>
        </li>
      ))}
    </ul>

    <h3 class="advisory">Consejo asesor</h3>
    <ul class="advisors" data-stagger>
      {advisors.map((a) => (
        <li><span class="area-label">{a.area}</span><span class="name">{a.name}</span></li>
      ))}
    </ul>

    <div class="friends" data-reveal>
      <div>
        <h3>Entidades amigas</h3>
        <p>{friends.name}</p>
      </div>
      <ul class="logos">
        {friends.institutions.map((i) => <li>{i}</li>)}
      </ul>
      <p class="note"><Placeholder text="Logos a definir (pendiente de autorización)" /></p>
    </div>
  </div>
</section>

<style>
  .people { display: grid; gap: 28px; margin-top: 20px; }
  .photo { aspect-ratio: 4 / 3; background: #e9e9e9; display: grid; place-items: center; margin-bottom: 14px; border-radius: var(--imp-radio); color: #595959; font-size: 0.875rem; }
  .name { font-weight: 700; color: var(--imp-negro); }
  .role { color: var(--imp-accion); font-weight: 600; min-height: 1.6em; }
  .area { font-size: 0.9375rem; }
  .advisory { margin-top: 56px; }
  .advisors { display: grid; gap: 0; margin-top: 16px; border-top: 1px solid var(--imp-gris-claro); }
  .advisors li { display: grid; gap: 2px; padding: 14px 0; border-bottom: 1px solid var(--imp-gris-claro); }
  .area-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--imp-gris); }
  .friends { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--imp-gris-claro); display: grid; gap: 16px; }
  .logos { display: flex; flex-wrap: wrap; gap: 12px; }
  .logos li { border: 1px solid var(--imp-gris); padding: 8px 20px; font-weight: 700; color: var(--imp-negro); background: #fff; letter-spacing: 0.06em; border-radius: var(--imp-radio); }
  @media (min-width: 768px) {
    .people { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .advisors { grid-template-columns: repeat(3, 1fr); column-gap: 32px; }
    .advisors li:nth-last-child(-n + 3) { border-bottom-color: var(--imp-gris-claro); }
    .friends { grid-template-columns: 1fr auto; align-items: center; }
    .friends .note { grid-column: 1 / -1; }
  }
</style>

---
import { referents } from '../../data/team';
import SectionHeading from '../ui/SectionHeading.astro';

const blocks = [
  { key: 'education', label: 'Formación' },
  { key: 'institutional', label: 'Institucional' },
  { key: 'independent', label: 'Independiente' },
] as const;
---

<section id="equipo" class="section bg-neutro" aria-labelledby="equipo-t">
  <div class="container">
    <SectionHeading id="equipo-t" eyebrow="Equipo" title="¿Quiénes integran IMPLUVIUM?" />

    <h3>Referentes</h3>
    <ul class="people" data-stagger>
      {referents.map((m) => (
        <li>
          <div class="photo" role="img" aria-label={`Foto de ${m.name}: a definir`}><span>Foto a definir</span></div>
          <p class="name">{m.name}</p>
          <p class="role">{m.role}</p>
          {blocks.map((b) => (
            <div class="bio" role="group" aria-label={`${b.label} de ${m.name}`}>
              <h4>{b.label}</h4>
              <ul>{m[b.key].map((line) => <li>{line}</li>)}</ul>
            </div>
          ))}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .people { display: grid; gap: 40px; margin-top: 20px; }
  .photo { aspect-ratio: 4 / 3; background: #e9e9e9; display: grid; place-items: center; margin-bottom: 14px; border-radius: var(--imp-radio); color: #595959; font-size: 0.875rem; }
  .name { font-weight: 700; color: var(--imp-negro); font-size: 1.125rem; }
  .role { color: var(--imp-accion); font-weight: 600; margin-bottom: 18px; }
  h4 { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--imp-gris); margin: 20px 0 8px; }
  .bio ul { display: grid; gap: 8px; font-size: 0.9375rem; }
  .bio ul li { padding-left: 16px; position: relative; }
  .bio ul li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 6px; height: 6px; border-radius: 50%; background: var(--imp-accion); }
  @media (min-width: 768px) { .people { grid-template-columns: repeat(2, 1fr); gap: 48px; } }
</style>

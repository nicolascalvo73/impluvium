---
import { Image } from 'astro:assets';
import { experiences, projects } from '../../data/background';
import type { BackgroundItem } from '../../types';
import SectionHeading from '../ui/SectionHeading.astro';

const groups: { id: string; title: string; items: BackgroundItem[] }[] = [
  { id: 'proyectos', title: 'Proyectos', items: projects },
  { id: 'experiencias', title: 'Experiencias', items: experiences },
];
---

<section id="antecedentes" class="section" aria-labelledby="antecedentes-t">
  <div class="container">
    <SectionHeading id="antecedentes-t" eyebrow="Antecedentes" title="¿Qué hicimos?" />
    {groups.map((g) => (
      <div class="group" role="group" aria-labelledby={`g-${g.id}`}>
        <h3 id={`g-${g.id}`}>{g.title}</h3>
        <ul class="grid">
          {g.items.map((item) => (
            <li>
              <figure>
                <div class="frame" data-img-reveal>
                  <Image src={item.image} alt={item.alt} width={400} height={400} widths={[240, 400, 560]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 30vw, 46vw" format="webp" quality={70} loading="lazy" />
                </div>
                <figcaption data-reveal>
                  <strong>{item.title}</strong>
                  <span>{item.place}</span>
                  {item.description && <span>{item.description}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .group + .group { margin-top: 56px; }
  h3 { margin-bottom: 20px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 14px; }
  figure { margin: 0; }
  /* Portadas cuadradas y uniformes; con 4 columnas cada portada mide como máximo ~300 px, lo que admiten las fotos de baja resolución. */
  .frame { aspect-ratio: 1; overflow: hidden; background: var(--imp-neutro-fondo); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter 0.4s, scale 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  @media (hover: hover) { figure:hover .frame :global(img) { filter: grayscale(0); scale: 1.03; } }
  figcaption { display: grid; gap: 2px; margin-top: 10px; font-size: 0.875rem; }
  strong { color: var(--imp-negro); font-size: 0.9375rem; line-height: 1.3; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 28px 20px; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .frame :global(img) { transition: none; } }
</style>

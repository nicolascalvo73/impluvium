---
interface Props { axis: 'urbanismo' | 'arquitectura' | 'educacion' | 'cultura' }
const { axis } = Astro.props;
const blocks = [
  [0, 0, 1], [1, 0, 0], [2, 0, 1], [3, 0, 0],
  [0, 1, 0], [1, 1, 1], [2, 1, 0], [3, 1, 1],
  [0, 2, 1], [1, 2, 0], [2, 2, 0], [3, 2, 1],
];
---

<svg class={`motif motif-${axis}`} viewBox="0 0 200 120" aria-hidden="true" focusable="false" data-tilt-art>
  {axis === 'urbanismo' && blocks.map(([x, y, solid]) => (
    <rect x={8 + x * 46} y={6 + y * 38} width="40" height="32" rx="2" class={solid ? 'solid' : 'line'} />
  ))}
  {axis === 'arquitectura' && [0, 1, 2].map((i) => {
    const r = 54 - i * 16;
    const spring = 66 + i * 14;
    return <path d={`M${100 - r} 114 V${spring} A${r} ${r} 0 0 1 ${100 + r} ${spring} V114`} class={i === 2 ? 'solid' : 'line'} />;
  })}
  {axis === 'educacion' && [0, 1, 2, 3].map((i) => (
    <rect x={16 + i * 44} y={96 - i * 28} width="36" height={20 + i * 28} rx="2" class={i === 3 ? 'solid' : 'line'} />
  ))}
  {axis === 'cultura' && [0, 1, 2, 3].map((i) => (
    <circle cx="100" cy="60" r={14 + i * 14} class={i === 0 ? 'solid' : 'line'} />
  ))}
</svg>

<style>
  .motif { color: var(--motif); width: 100%; max-height: 120px; display: block; margin-bottom: 4px; }
  .line { fill: none; stroke: currentColor; stroke-width: 2; }
  .solid { fill: currentColor; stroke: currentColor; stroke-width: 2; opacity: 0.55; }
</style>

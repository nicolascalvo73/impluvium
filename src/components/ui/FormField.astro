---
interface Props {
  id: string; name: string; label: string;
  type?: 'text' | 'email' | 'textarea'; required?: boolean; placeholder?: string; autocomplete?: string;
}
const { id, name, label, type = 'text', required = true, placeholder, autocomplete } = Astro.props;
---

<div class="field">
  <label for={id}>{label}</label>
  {type === 'textarea' ? (
    <textarea {id} {name} {required} data-validate aria-describedby={`${id}-error`} />
  ) : (
    <input {id} {name} {type} {required} {placeholder} {autocomplete} data-validate aria-describedby={`${id}-error`} />
  )}
  <p class="field-error" id={`${id}-error`} data-error-for={id} aria-live="polite"></p>
</div>

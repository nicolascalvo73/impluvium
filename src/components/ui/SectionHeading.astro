---
interface Props { id: string; eyebrow?: string; title: string; lead?: string; as?: 'h1' | 'h2' }
const { id, eyebrow, title, lead, as: Tag = 'h2' } = Astro.props;
---

<div class="section-head" data-reveal>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id}>{title}</Tag>
  </div>
  {lead && <p class="lead">{lead}</p>}
</div>

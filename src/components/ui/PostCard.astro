---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { longDate } from '../../lib/dates';
import SampleTag from './SampleTag.astro';

interface Props { post: CollectionEntry<'blog'>; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel: H = 'h3' } = Astro.props;
const { title, date, type, summary, image, imageAlt, sample } = post.data;
---

<article class="post">
  <div class="img">
    <Image src={image} alt={imageAlt} width={640} height={400} widths={[320, 480, 640]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 92vw" format="webp" quality={70} loading="lazy" />
  </div>
  <div class="meta">
    <span class="type">{type}</span>
    <time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>
  </div>
  <H>{title}</H>
  <p class="summary">{summary}</p>
  {sample && <SampleTag />}
</article>

<style>
  .post { display: grid; gap: 10px; align-content: start; }
  .img { aspect-ratio: 8 / 5; overflow: hidden; background: var(--imp-neutro-fondo); margin-bottom: 4px; }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter 0.4s, scale 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .post:hover .img :global(img) { filter: grayscale(0); scale: 1.03; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; font-size: 0.8125rem; }
  .type { border: 1px solid var(--imp-negro); color: var(--imp-negro); padding: 1px 8px; border-radius: 3px; font-weight: 600; }
  time { color: var(--imp-gris); }
  :global(.post) h2, :global(.post) h3 { font-size: 1.25rem; }
  .summary { font-size: 0.9375rem; font-weight: 300; }
  .post :global(.sample-tag) { justify-self: start; }
</style>

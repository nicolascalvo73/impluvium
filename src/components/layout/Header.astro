---
import isotipo from '../../assets/logo/impluvium-isotipo-negro.svg';
import { navItems, ctaItem } from '../../data/nav';
import { site } from '../../data/site';
import { homeAnchor, url } from '../../lib/url';
import Button from '../ui/Button.astro';

interface Props { current?: 'home' | 'programa' | 'blog' }
const { current = 'home' } = Astro.props;

const resolve = (href: string) => (href.startsWith('#') ? homeAnchor(href.slice(1)) : url(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${site.fullName}, inicio`}>
      <img src={isotipo.src} alt="" width="26" height="40" />
      <span class="wordmark">{site.name} <span class="ac">{site.suffix}</span></span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menú</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Principal" data-menu>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={resolve(item.href)} aria-current={item.page === current ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <Button href={resolve(ctaItem.href)} class="nav-cta">{ctaItem.label}</Button>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; height: var(--imp-header-h); background: #fff; border-bottom: 1px solid var(--imp-gris-claro); }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--imp-negro); }
  .wordmark { font-weight: 700; font-size: 1.125rem; letter-spacing: 0.01em; }
  .ac { text-transform: lowercase; }

  .menu-toggle { width: 48px; height: 48px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; }
  .bars, .bars::before, .bars::after { display: block; width: 24px; height: 2px; background: var(--imp-negro); content: ''; position: relative; transition: transform 0.2s; }
  .bars::before { position: absolute; top: -7px; }
  .bars::after { position: absolute; top: 7px; }
  .menu-toggle[aria-expanded='true'] .bars { background: transparent; }
  .menu-toggle[aria-expanded='true'] .bars::before { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bars::after { transform: translateY(-7px) rotate(-45deg); }

  .nav { display: none; position: absolute; top: var(--imp-header-h); left: 0; right: 0; background: #fff; border-bottom: 1px solid var(--imp-gris-claro); padding: 8px var(--imp-gutter) 24px; }
  .nav.open { display: block; }
  .nav ul { display: grid; }
  .nav li a { display: block; padding: 14px 0; color: var(--imp-negro); text-decoration: none; font-weight: 400; border-bottom: 1px solid #eee; }
  .nav li a:hover { color: var(--imp-accion); }
  .nav li a[aria-current='page'], .nav li a.is-active { font-weight: 700; color: var(--imp-accion); }
  .nav :global(.nav-cta) { margin-top: 20px; width: 100%; }

  @media (min-width: 1100px) {
    .menu-toggle { display: none; }
    .nav { display: flex; position: static; align-items: center; gap: 28px; border: 0; padding: 0; background: none; }
    .nav ul { display: flex; gap: 22px; }
    .nav li a { padding: 6px 0; border: 0; font-size: 0.9375rem; border-bottom: 2px solid transparent; }
    .nav li a { background: linear-gradient(var(--imp-accion), var(--imp-accion)) 0 100% / 0 2px no-repeat; transition: background-size 0.3s ease; }
    .nav li a:hover, .nav li a.is-active { background-size: 100% 2px; }
    .nav li a[aria-current='page'] { border-bottom-color: var(--imp-accion); }
    .nav :global(.nav-cta) { margin: 0; width: auto; min-height: 44px; padding: 8px 20px; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); toggle.focus(); } });
  }
</script>
